# Copy to .env and fill in. Never commit the real .env.

# --- Required in production ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# DB_PATH=productivity.db

# --- Admins (comma-separated) ---
ADMIN_EMAILS=

# --- Email (SMTP or Brevo) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
# BREVO_API_KEY=
# EMAIL_MODE=

VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5

# --- Login throttling ---
# LOGIN_MAX_FAILURES=10
# LOGIN_FAILURE_WINDOW_MINUTES=15

# --- Sheety (optional fallback for single-user setups) ---
SHEETY_ENDPOINT=

# --- Local development only ---
# FLASK_ENV=development
# LOCAL_AUTH_BYPASS=1
# LOCAL_AUTH_USER_ID=1
# LOG_VERIFICATION_CODES=1
# DISABLE_CLOUD_SYNC=1
